#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        // Default layer positions 19 = K and 20 = L (zero-based).
        prolonged_sound_mark {
            bindings = <&kp MINUS>;
            key-positions = <19 20>;
            layers = <0>;
        };

        z_held_kl_equal {
            bindings = <&kp LS(MINUS)>;
            key-positions = <19 20>;
            layers = <7>;
            timeout-ms = <50>;
        };

        qtyp_text {
            bindings = <&qtyp_text_macro>;
            key-positions = <0 4 5 9>;
            layers = <0>;
            timeout-ms = <150>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };
    };

    macros {
        layer1_ctrl_hold: layer1_ctrl_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "LAYER1_CTRL_HOLD";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press>, <&kp LEFT_CONTROL>, <&mo 8>,
                       <&macro_pause_for_release>,
                       <&macro_release>, <&mo 8>, <&kp LEFT_CONTROL>;
        };

        qtyp_text_macro: qtyp_text_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "QTYP_TEXT";
            wait-ms = <20>;
            tap-ms = <10>;
            bindings = <&kp LS(K)>, <&kp A>, <&kp N>, <&kp C>, <&kp H>,
                       <&kp I>, <&kp N1>, <&kp N7>, <&kp N2>, <&kp N9>;
        };

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        layer1_a_taps: layer1_a_taps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&kp LC(A)>;
            display-name = "Double Select All";
        };

        layer2_copy: layer2_copy {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "C / Ctrl+C";
            bindings = <&kp LANG1>, <&kp C>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
            keep-mods = <(MOD_LCTL | MOD_RCTL)>;
        };

        layer2_paste: layer2_paste {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "V / Ctrl+V";
            bindings = <&kp LANG2>, <&kp V>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
            keep-mods = <(MOD_LCTL | MOD_RCTL)>;
        };

        layer1_hold_only: layer1_hold_only {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&none>;
            display-name = "Hold Layer 1";
        };

        z_tap_only: z_tap_only {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            bindings = <&mo>, <&kp>;
            hold-trigger-key-positions = <19 20 33>;
            display-name = "Z / Question Layer";
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        layer1_copy_hold: layer1_copy_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            hold-while-undecided;
            bindings = <&layer1_ctrl_hold>, <&layer1_a_taps>;
            display-name = "A / Ctrl";
        };

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P
&kp A  &kp S  &kp D  &kp F  &kp G  &mkp RCLK  &kp UP_ARROW  &kp H  &kp J  &kp K  &lt 4 L  &lt 5 MINUS
&z_tap_only 7 Z  &kp X  &kp C  &kp V  &kp B  &kp LEFT_CONTROL  &kp DOWN_ARROW  &kp N  &kp M  &kp COMMA  &kp DOT  &mt LEFT_SHIFT SLASH
&kp LEFT_CONTROL  &kp LEFT_GUI  &kp LEFT_ALT  &lt 6 INTERNATIONAL_4  &layer1_hold_only 1 0  &mt LEFT_SHIFT SPACE  &kp BACKSPACE  &layer1_hold_only 2 0  &tog 4
            >;

            sensor-bindings = <&ROTATE SCRL_UP SCRL_DOWN>;
        };

        FUNCTION {
            bindings = <
&kp TAB  &kp LS(N7)  &kp LEFT_BRACKET  &kp LS(LEFT_BRACKET)  &trans  &trans  &kp RIGHT_BRACKET  &kp NON_US_HASH  &trans  &kp EQUAL
&layer1_copy_hold 0 A  &kp LS(N4)  &kp LS(N5)  &kp LS(N6)  &kp LS(INTERNATIONAL_3)  &trans  &kp LC(C)  &kp LA(LC(TAB))  &kp LS(N8)  &kp LS(N9)  &kp SEMICOLON  &kp SINGLE_QUOTE
&kp LEFT_SHIFT  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &trans  &trans  &kp LC(V)  &trans  &kp LS(RIGHT_BRACKET)  &kp LS(NON_US_HASH)  &trans  &kp INTERNATIONAL_1
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        NUM {
            bindings = <
&kp ESC  &kp HOME  &kp UP_ARROW  &kp END  &kp PAGE_UP  &kp LS(N6)  &kp N7  &kp N8  &kp N9  &kp LS(N0)
&kp LEFT_CONTROL  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAGE_DOWN  &kp LG(LA(K))  &kp LS(MINUS)  &kp LS(N1)  &kp N4  &kp N5  &kp N6  &kp LS(N5)
&kp LEFT_SHIFT  &kp KP_N1  &layer2_copy  &layer2_paste  &kp DOT  &trans  &trans  &kp N0  &kp N1  &kp N2  &kp N3  &kp BACKSLASH
&trans  &trans  &trans  &trans  &kp KP_ENTER  &trans  &trans  &trans  &kp LS(BACKSLASH)
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        ARROW {
            bindings = <
&kp ESC  &kp LS(LC(TAB))  &kp UP_ARROW  &kp LC(TAB)  &trans  &trans  &trans  &trans  &trans  &trans
&kp HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans  &kp LG(LS(RIGHT_ARROW))  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_DOWN) LC(PAGE_UP)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp LCLK  &mkp RCLK  &mo 5
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MCLK  &none
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &kp F12  &kp F7  &kp F8  &kp F9  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans  &studio_unlock  &kp F11  &kp F4  &kp F5  &kp F6  &trans
&trans  &kp N1  &kp N2  &kp N3  &kt KP_N4  &trans  &bootloader  &kp F10  &kp F1  &kp F2  &kp F3  &bt BT_CLR
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR_ALL
            >;
        };

        z_question_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp QUESTION
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer1_copy_paste {
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P
&kp A  &kp S  &kp D  &kp F  &kp G  &mkp RCLK  &kp UP_ARROW  &kp H  &kp J  &kp K  &kp L  &kp MINUS
&kp Z  &kp X  &kp C  &kp V  &kp B  &kp LEFT_CONTROL  &kp DOWN_ARROW  &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_SHIFT  &kp LEFT_GUI  &kp LEFT_ALT  &lt 6 INTERNATIONAL_4  &layer1_hold_only 1 0  &mt LEFT_SHIFT SPACE  &kp BACKSPACE  &layer1_hold_only 2 0  &tog 4
            >;
        };
    };
};
